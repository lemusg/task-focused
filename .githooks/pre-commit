#!/bin/sh
# Strip the extension key from manifest.json before committing.
# This avoids a full frontend build in the pre-commit path.

cd "$(git rev-parse --show-toplevel)/frontend" || exit 1

echo "pre-commit: stripping extension key from manifest..."
node ../extension/sync-manifest-env.mjs --no-key

# Stage the updated manifest so the keyless version is what gets committed
git add ../extension/manifest.json
