{
  "manifest_version": 3,
  "name": "Task Focused",
  "version": "1.0.0",
  "description": "Task to keep you focused on your work",
  "action": {
    "default_popup": "dist/index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "identity",
    "identity.email",
    "storage"
  ],
  "oauth2": {
    "client_id": "458085931355-abugudoavmkndu93ohsflh4fi5d6h0r5.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "profile"
    ]
  },
  "host_permissions": [
    "http://localhost:3000/*",
    "https://your-backend-domain.com/*"
  ],
  "key": ""
}
