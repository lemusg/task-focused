{
  "manifest_version": 3,
  "name": "Task Focused",
  "version": "1.0.0",
  "description": "Task to keep you focused on your work",
  "action": {
    "default_popup": "dist/index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "identity",
    "identity.email",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "oauth2": {
    "client_id": "458085931355-v3tqsu6jdh5uk1eeefnpsqovuvjksboq.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "profile"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:8000/*",
    "https://your-backend-domain.com/*"
  ]
}
